---
import { BUSINESS } from '../data/business';
import { WEEKLY_RATE, formatVnd } from '../data/pricing';
import { useTranslations } from '../i18n';
import type { Locale } from '../i18n/config';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const t = await useTranslations(locale);

const phone = BUSINESS.phone;
const phoneDigits = phone.replace('+', '');

const ZALO = `<path d="M22.782.166H27.2c6.066 0 9.611.891 12.758 2.578 3.147 1.687 5.63 4.152 7.298 7.299 1.688 3.147 2.579 6.692 2.579 12.758V27.2c0 6.066-.891 9.611-2.579 12.758-1.687 3.147-4.151 5.63-7.298 7.298-3.147 1.688-6.692 2.579-12.758 2.579h-4.398c-6.067 0-9.612-.891-12.759-2.579-3.146-1.687-5.63-4.151-7.298-7.298C1.057 36.81.166 33.265.166 27.199V22.8c0-6.066.891-9.611 2.578-12.758C4.432 6.896 6.896 4.412 10.043 2.744 13.171 1.057 16.735.166 22.782.166Z" fill="#0068FF"/><path d="M7.779 43.589c2.323.257 5.227-.405 7.289-1.406 8.954 4.949 22.951 4.713 31.424-.709.329-.493.636-1.005.92-1.537C49.106 36.778 50 33.22 50 27.132V22.717c0-6.088-.894-9.646-2.587-12.804-1.675-3.159-4.167-5.632-7.325-7.326C36.929.894 33.371 0 27.283 0H22.85c-5.186 0-8.552.653-11.38 1.899-.155.138-.307.279-.455.422-8.298 8-8.929 25.339-1.892 34.757l.027.043c1.084 1.598.038 4.395-1.598 6.031-.267.247-.171.4.228.437Z" fill="#fff"/><path d="M20.563 17h-9.725v2.085h6.749l-6.654 8.247c-.208.303-.36.587-.36 1.232v.531h9.175c.455 0 .834-.379.834-.834v-1.119h-7.09l6.256-7.848c.095-.114.265-.322.341-.417l.038-.057c.36-.531.436-.986.436-1.535V17Z" fill="#0068FF"/><path d="M32.942 29.095h1.383V17h-2.085v11.393c0 .38.303.702.702.702Z" fill="#0068FF"/><path d="M25.814 19.692a4.74 4.74 0 1 0 0 9.479 4.74 4.74 0 0 0 0-9.48Zm0 7.527a2.787 2.787 0 1 1 0-5.574 2.787 2.787 0 0 1 0 5.574Z" fill="#0068FF"/><path d="M40.487 19.616a4.777 4.777 0 1 0 0 9.555 4.777 4.777 0 0 0 0-9.555Zm0 7.602a2.806 2.806 0 1 1 0-5.611 2.806 2.806 0 0 1 0 5.611Z" fill="#0068FF"/><path d="M29.456 29.094h1.119v-9.137h-1.953v8.322c0 .436.379.815.834.815Z" fill="#0068FF"/>`;

