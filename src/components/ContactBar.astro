const channels = [
  { id: 'zalo', label: 'Zalo', href: `https://zalo.me/${phoneDigits}`, appOnly: false, viewBox: '0 0 50 50', svg: ZALO },
  { id: 'whatsapp', label: 'WhatsApp', href: `https://wa.me/${phoneDigits}`, appOnly: false, viewBox: '0 0 24 24', svg: WHATSAPP },
  { id: 'wechat', label: 'WeChat', href: `weixin://dl/chat?phone=${phone}`, appOnly: true, viewBox: '0 0 24 24', svg: WECHAT },
  { id: 'kakao', label: 'KakaoTalk', href: `kakaotalk://launch?phone=${phone}`, appOnly: true, viewBox: '0 0 24 24', svg: KAKAO },
];
---


<div
  id="contact-dock"
  class="fixed inset-x-3 bottom-[max(0.75rem,env(safe-area-inset-bottom))] z-30 md:inset-x-auto md:bottom-6 md:right-6 md:w-[400px]"
>
  <div
    id="contact-sheet"
    class="absolute inset-x-0 bottom-[calc(100%+8px)] hidden flex-col rounded-card border border-(--line) bg-(--card) p-2 shadow-2xl shadow-black/40"
  >
    {
      channels.map((c) => (
        <a
          href={c.href}
          target={c.appOnly ? undefined : '_blank'}
          rel="noopener"
          data-channel={c.id}
          data-channel-label={c.label}
          data-app-only={c.appOnly ? 'true' : undefined}
          data-phone={BUSINESS.phoneDisplay}
          class="flex min-h-14 items-center gap-3 rounded-[14px] px-2.5 text-base font-semibold transition hover:bg-(--card-2)"
        >
          <span class="grid size-9 shrink-0 place-items-center">
            <svg viewBox={c.viewBox} class="size-8" aria-hidden="true" set:html={c.svg} />
          </span>
          <span class="flex-1">{c.label}</span>
          {c.appOnly ? (
            <span class="text-[13px] font-medium text-(--muted)">{t('contact.copy_number')}</span>
          ) : (
            <svg class="size-4 text-(--muted)" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M5 12h14M13 6l6 6-6 6" />
            </svg>
          )}
        </a>
      ))
    }
  </div>

  <div class="flex items-center justify-between gap-3 rounded-full border border-(--line) bg-(--card)/90 py-2 pl-[18px] pr-2 shadow-xl shadow-black/40 backdrop-blur-xl">
    <div class="flex flex-col leading-tight">
      <span class="text-xs text-(--muted)">{t('fleet.from')}</span>
      <span class="font-display text-[17px] font-bold tabular-nums">
        {formatVnd(WEEKLY_RATE)}
        <span class="font-body text-[13px] font-normal text-(--muted)">{t('price.per_day')}</span>
      </span>
    </div>
    <button
      id="contact-toggle"
      type="button"
      aria-expanded="false"
      aria-controls="contact-sheet"
      class="flex h-12 cursor-pointer items-center gap-2 rounded-full bg-accent px-5 text-[15px] font-semibold text-(--color-accent-ink) transition hover:brightness-110 active:scale-[0.97]"
    >
      <svg class="size-[18px]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M21 12a8 8 0 0 1-11.6 7.1L4 20l1-4.6A8 8 0 1 1 21 12z" />
      </svg>
      <span>{t('contact.chat_to_book')}</span>
    </button>
  </div>
</div>

<div
  id="contact-toast"
  role="status"
  aria-live="polite"
  class="pointer-events-none fixed bottom-28 left-1/2 z-50 -translate-x-1/2 rounded-full bg-(--fg) px-4 py-2 text-sm font-medium text-(--bg) opacity-0 shadow-xl transition-opacity duration-300 md:bottom-28"
>
</div>

<script>
  import { animate, stagger } from 'motion';
  import { prefersReducedMotion } from '../lib/motion/prefersReducedMotion';

  let detach: VoidFunction | undefined;

  const initContactDock = () => {
    detach?.();
    const dock = document.getElementById('contact-dock');
    const sheet = document.getElementById('contact-sheet');
    const toggle = document.getElementById('contact-toggle');
    const toast = document.getElementById('contact-toast');
    if (!dock || !sheet || !toggle) return;

    const reduced = prefersReducedMotion();
    const links = Array.from(sheet.querySelectorAll<HTMLAnchorElement>('a'));
    let open = false;

    if (!reduced && !dock.dataset.shown) {
      dock.dataset.shown = 'true';
      animate(
        dock,
        { opacity: [0, 1], transform: ['translateY(24px)', 'translateY(0)'] },
        { duration: 0.5, delay: 0.4, ease: [0.16, 1, 0.3, 1] },
      );
    }

    const setOpen = (next: boolean) => {
      if (next === open) return;
      open = next;
      toggle.setAttribute('aria-expanded', String(open));
      sheet.classList.toggle('hidden', !open);
      sheet.classList.toggle('flex', open);
      if (!open || reduced) return;
      animate(
        sheet,
        { opacity: [0, 1], transform: ['translateY(10px) scale(0.98)', 'translateY(0) scale(1)'] },
        { duration: 0.3, ease: [0.16, 1, 0.3, 1] },
      );
      animate(
        links,
        { opacity: [0, 1], transform: ['translateY(12px)', 'translateY(0)'] },
        { duration: 0.35, delay: stagger(0.04), ease: [0.16, 1, 0.3, 1] },
      );
    };

    let toastTimer: ReturnType<typeof setTimeout> | undefined;
    const showToast = (message: string) => {
      if (!toast) return;
      toast.textContent = message;
      toast.style.opacity = '1';
      clearTimeout(toastTimer);
      toastTimer = setTimeout(() => (toast.style.opacity = '0'), 2400);
    };

    const onToggle = (event: MouseEvent) => {
      event.stopPropagation();
      setOpen(!open);
    };
    const onDocumentClick = (event: MouseEvent) => {
      if (open && !dock.contains(event.target as Node)) setOpen(false);
    };
    const onKey = (event: KeyboardEvent) => {
      if (event.key === 'Escape') setOpen(false);
    };
    const onChannelClick = (event: MouseEvent) => {
      const link = event.currentTarget as HTMLAnchorElement;
      if (link.dataset.appOnly !== 'true' || window.matchMedia('(pointer: coarse)').matches) return;
      event.preventDefault();
      const phone = link.dataset.phone || '';
      const label = link.dataset.channelLabel || '';
      navigator.clipboard?.writeText(phone).then(
        () => showToast(`${label}: ${phone} copied`),
        () => showToast(`${label}: ${phone}`),
      );
    };

    toggle.addEventListener('click', onToggle);
    document.addEventListener('click', onDocumentClick);
    document.addEventListener('keydown', onKey);
    links.forEach((link) => link.addEventListener('click', onChannelClick));

    detach = () => {
      toggle.removeEventListener('click', onToggle);
      document.removeEventListener('click', onDocumentClick);
      document.removeEventListener('keydown', onKey);
      links.forEach((link) => link.removeEventListener('click', onChannelClick));
    };
  };

  document.addEventListener('astro:page-load', initContactDock);
</script>
