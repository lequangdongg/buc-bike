---
import { Image } from 'astro:assets';
import feliz from '../assets/feliz-lite-bright.png';
import { useTranslations } from '../i18n';
import type { Locale } from '../i18n/config';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const t = await useTranslations(locale);
const points = t('showcase.points', { returnObjects: true }) as { title: string; body: string }[];

const positions = [
  { x: 54, y: 30 },
  { x: 70, y: 47 },
  { x: 30, y: 72 },
  { x: 49, y: 62 },
  { x: 40, y: 40 },
];
---

<section data-showcase class="mx-auto max-w-6xl px-5 pt-16 md:pt-32">
  <div class="grid items-center gap-3 md:grid-cols-2 md:gap-16">
    <div data-reveal class="relative mx-auto aspect-square w-full max-w-[560px]">
      <div class="absolute inset-[14%] rounded-full bg-charge/12 blur-3xl" aria-hidden="true"></div>
      <div class="absolute inset-[6%] rounded-full border border-(--line)" aria-hidden="true"></div>
      <Image src={feliz} alt="VinFast Feliz Lite" width={800} height={800} class="absolute inset-0 h-full w-full object-contain p-3" />
      {
        points.map((point, i) => (
          <button
            data-hotspot={i}
            data-active={i === 0 ? 'true' : 'false'}
            type="button"
            aria-label={`${i + 1}. ${point.title}`}
            style={`left:${positions[i].x}%;top:${positions[i].y}%`}
            class="absolute grid size-11 -translate-x-1/2 -translate-y-1/2 cursor-pointer place-items-center rounded-full"
          >
            <span class="hs-ping" aria-hidden="true" />
            <span class="hs-num">{i + 1}</span>
          </button>
        ))
      }
    </div>

    <div data-reveal>
      <p class="font-display text-sm font-medium uppercase tracking-[0.2em] text-(--accent-text)">{t('showcase.kicker')}</p>
      <h2 class="mt-3 font-display text-3xl font-bold tracking-tight sm:text-4xl md:text-5xl">{t('showcase.heading')}</h2>
      <div class="mt-6 flex flex-col gap-2">
        {
          points.map((point, i) => (
            <button
              data-callout={i}
              data-active={i === 0 ? 'true' : 'false'}
              type="button"
              aria-pressed={i === 0 ? 'true' : 'false'}
              class="hs-row"
            >
              <span class="hs-row-num">{String(i + 1).padStart(2, '0')}</span>
              <span class="flex flex-1 flex-col gap-1">
                <span class="font-display text-lg font-bold leading-snug">{point.title}</span>
                <span class="hs-row-body">{point.body}</span>
              </span>
            </button>
          ))
        }
      </div>
      <p class="mt-4 text-xs uppercase tracking-wider text-(--muted)">{t('showcase.tap_hint')}</p>
    </div>
  </div>
</section>

<style>
  .hs-num {
    position: relative;
    display: grid;
    place-items: center;
    width: 30px;
    height: 30px;
    border-radius: 9999px;
    border: 2px solid var(--color-accent);
    background: color-mix(in srgb, var(--bg) 72%, transparent);
    color: var(--accent-text);
    font-family: var(--font-display);
    font-size: 14px;
    font-weight: 700;
    line-height: 1;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.45);
    transition: transform 0.3s ease, background 0.3s ease, color 0.3s ease;
  }
  [data-hotspot][data-active='true'] .hs-num {
    transform: scale(1.2);
    background: var(--color-accent);
    color: var(--color-accent-ink);
  }
  .hs-ping {
    position: absolute;
    inset: 6px;
    border-radius: 9999px;
    border: 2px solid var(--color-accent);
    opacity: 0;
  }
  [data-hotspot][data-active='true'] .hs-ping {
    animation: bk-ping 1.5s ease-out infinite;
  }
  .hs-row {
    display: flex;
    align-items: flex-start;
    gap: 16px;
    width: 100%;
    min-height: 58px;
    padding: 15px 16px;
    border: 1px solid var(--line);
    border-radius: 16px;
    background: transparent;
    text-align: left;
    cursor: pointer;
    transition: border-color 0.3s ease, background 0.3s ease;
  }
  .hs-row[data-active='true'] {
    border-color: var(--color-accent);
    background: var(--card);
  }
  .hs-row-num {
    flex: 0 0 34px;
    font-family: var(--font-display);
    font-size: 20px;
    font-weight: 700;
    line-height: 1.3;
    font-variant-numeric: tabular-nums;
    color: var(--muted);
    transition: color 0.3s ease;
  }
  .hs-row[data-active='true'] .hs-row-num {
    color: var(--accent-text);
  }
  .hs-row-body {
    display: none;
    font-size: 15px;
    color: var(--muted);
  }
  .hs-row[data-active='true'] .hs-row-body {
    display: block;
    animation: bk-pop 0.35s cubic-bezier(0.16, 1, 0.3, 1) both;
  }
</style>
