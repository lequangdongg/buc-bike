---
import { Image } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import { useTranslations } from '../../i18n';
import { localizePath, type Locale } from '../../i18n/config';
import { BIKES, type Bike } from '../../data/fleet';
import { DAILY_RATE, OVER_3_DAYS_RATE, WEEKLY_RATE, formatVnd } from '../../data/pricing';
import { buildProductsJsonLd } from '../../lib/seo';

interface Props {
  locale: Locale;
  path: string;
}
const { locale, path } = Astro.props;
const t = await useTranslations(locale);
const link = (p: string) => localizePath(p, locale);

const metrics = [
  { id: 'range', tab: t('fleet.range_label'), label: t('fleet.per_charge'), best: t('fleet.best_range'), unit: 'km', read: (bike: Bike) => bike.rangeKm },
  { id: 'speed', tab: t('fleet.speed_label'), label: t('fleet.speed_label'), best: t('fleet.best_speed'), unit: 'km/h', read: (bike: Bike) => bike.topSpeedKmh },
  { id: 'trunk', tab: t('fleet.trunk_label'), label: t('fleet.trunk_label'), best: t('fleet.best_trunk'), unit: 'L', read: (bike: Bike) => bike.trunkL },
].map((metric) => ({ ...metric, max: Math.max(...BIKES.map(metric.read)) }));
const initial = metrics[0];

const includes = t('price.includes', { returnObjects: true }) as string[];
const plans = t('price.plans', { returnObjects: true }) as { name: string; note: string }[];
const rates = [
  { name: plans[0].name, price: DAILY_RATE, accent: false },
  { name: plans[1].name, price: OVER_3_DAYS_RATE, accent: false },
  { name: plans[2].name, price: WEEKLY_RATE, accent: true },
];

const kicker = 'font-display text-sm font-medium uppercase tracking-[0.2em] text-(--accent-text)';
---

<Base
  title={`${t('fleet.heading')} — ${t('site.name')}`}
  description={t('fleet.intro')}
  locale={locale}
  path={path}
  jsonLd={buildProductsJsonLd()}
>
  <section class="mx-auto max-w-6xl px-5 pt-28 md:pt-36">
    <div class="flex flex-wrap items-end justify-between gap-x-12 gap-y-7">
      <div class="flex-[1_1_520px]">
        <p class:list={[kicker, 'enter']}>{t('fleet.kicker')}</p>
        <h1 class="enter mt-3 font-display text-[clamp(2.75rem,6.4vw,5.25rem)] font-bold leading-none tracking-[-0.03em]" style="--d:.08s">{t('fleet.heading')}</h1>
        <p class="enter mt-4 max-w-[560px] text-base text-(--muted) md:text-lg" style="--d:.18s">{t('fleet.intro')}</p>
      </div>
      <div class="enter flex max-w-[420px] flex-[1_1_320px] flex-col gap-2" style="--d:.28s">
        <span id="compare-label" class="text-xs uppercase tracking-[0.08em] text-(--muted)">{t('fleet.compare_by')}</span>
        <div role="group" aria-labelledby="compare-label" class="flex gap-1 rounded-full border border-(--line) bg-(--card) p-1">
          {
            metrics.map((metric) => (
              <button
                type="button"
                data-metric-tab={metric.id}
                data-label={metric.label}
                data-best={metric.best}
                data-unit={metric.unit}
                data-max={metric.max}
                aria-pressed={metric.id === initial.id ? 'true' : 'false'}
                class="h-11 flex-1 cursor-pointer truncate rounded-full px-2 text-[13px] font-semibold transition duration-300 aria-pressed:bg-accent aria-pressed:text-(--color-accent-ink) sm:text-sm"
              >
                {metric.tab}
              </button>
            ))
          }
        </div>
      </div>
    </div>

    <div class="mt-6 grid gap-4 md:mt-12 md:grid-cols-3 md:gap-5">
      {
        BIKES.map((bike, i) => {
          const value = initial.read(bike);
          const isBest = value === initial.max;
          return (
            <article
              data-fleet-card
              data-range={bike.rangeKm}
              data-speed={bike.topSpeedKmh}
              data-trunk={bike.trunkL}
              class="group flex flex-col overflow-hidden rounded-card border border-(--line) bg-(--card) transition duration-300 hover:border-accent md:hover:-translate-y-1.5 md:hover:shadow-2xl md:hover:shadow-black/30"
              style={`animation: bk-rise .8s cubic-bezier(.16,1,.3,1) ${0.3 + i * 0.1}s backwards`}
            >
              <div class="bike-tile h-60 border-b border-(--line) md:h-80">
                <span class="bike-tile-glow" style={`background:${bike.glow}`} aria-hidden="true" />
                <span class="bike-tile-ring" aria-hidden="true" />
                <Image
                  src={bike.image}
                  alt={bike.name}
                  width={520}
                  loading="eager"
                  class="bike-tile-img"
                  data-padded={bike.imagePadded ? 'true' : 'false'}
                  style={`view-transition-name: bike-${bike.id}`}
                />
                <span class="absolute left-3.5 top-3.5 flex items-center gap-1.5 rounded-full border border-(--line) bg-(--bg)/80 px-3 py-1 text-xs font-medium text-(--accent-text)">
                  <span class="size-1.5 rounded-full bg-charge" aria-hidden="true" />
                  {t('fleet.available')}
                </span>
                <span data-metric-best hidden={!isBest} class="absolute right-3.5 top-3.5 rounded-full bg-charge px-3 py-1 text-xs font-semibold text-(--color-accent-ink)">
                  {initial.best}
                </span>
              </div>
              <div class="flex flex-col gap-4 p-[18px] md:gap-[18px] md:p-6">
                <h2 class="font-display text-[22px] font-bold leading-tight">{bike.name}</h2>
                <div class="flex flex-col gap-2">
                  <div class="flex items-baseline justify-between gap-3">
                    <span data-metric-label class="text-xs uppercase tracking-[0.06em] text-(--muted)">{initial.label}</span>
                    <span data-metric-value class="font-display text-[22px] font-bold tabular-nums text-(--accent-text)">{value} {initial.unit}</span>
                  </div>
                  <div class="h-2 overflow-hidden rounded-full bg-(--card-2)" aria-hidden="true">
                    <div
                      data-metric-fill
                      data-best={isBest ? 'true' : 'false'}
                      class="h-full rounded-full bg-accent transition-[width,background-color] duration-700 ease-[cubic-bezier(0.16,1,0.3,1)] data-[best=true]:bg-charge"
                      style={`width:${Math.round((value / initial.max) * 100)}%`}
                    />
                  </div>
                </div>
                <p class="text-sm text-(--muted)">
                  {bike.rangeKm} km · {bike.topSpeedKmh} km/h · {bike.trunkL} L
                  {bike.trunkWithExtraBatteryL !== null && <span class="block">{t('fleet.extra_battery')}</span>}
                </p>
                <a
                  href={link(`/fleet/${bike.id}`)}
                  class="mt-auto flex h-12 items-center justify-center gap-2 rounded-full border border-(--line) text-[15px] font-semibold transition hover:border-accent hover:text-(--accent-text) active:scale-[0.97]"
                >
                  {t('fleet.view_detail')}
                  <svg class="size-4 transition group-hover:translate-x-1" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <path d="M5 12h14M13 6l6 6-6 6" />
                  </svg>
                </a>
              </div>
            </article>
          );
        })
      }
    </div>
    <p class="mt-4 text-[13px] text-(--muted)">{t('fleet.range_disclaimer')}</p>
  </section>

  <section class="mx-auto grid max-w-6xl gap-14 px-5 pt-14 md:pt-28 lg:grid-cols-2 lg:items-start lg:gap-6">
    <div data-reveal>
      <h2 class="font-display text-2xl font-bold tracking-tight md:text-[34px]">{t('price.includes_heading')}</h2>
      <ul class="mt-[18px] grid grid-cols-2 gap-2.5">
        {
          includes.map((item) => (
            <li class="flex items-center gap-2.5 rounded-2xl border border-(--line) p-3.5 text-sm font-medium leading-snug">
              <svg class="size-[18px] shrink-0 text-charge light:text-(--accent-text)" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M5 12.5l4.5 4.5L19 7.5" />
              </svg>
              {item}
            </li>
          ))
        }
      </ul>
    </div>
    <div data-reveal class="flex flex-col gap-5 rounded-card border border-(--line) bg-(--card) p-6">
      <div>
        <p class={kicker}>{t('price.daily.eyebrow')}</p>
        <h2 class="mt-2 font-display text-2xl font-bold tracking-tight md:text-[34px] md:leading-tight">{t('price.daily.applies')}</h2>
      </div>
      <dl class="grid grid-cols-3 border-t border-(--line)">
        {
          rates.map((rate, i) => (
            <div class:list={['flex flex-col gap-0.5 pt-3.5', i > 0 && 'border-l border-(--line) pl-3', i < rates.length - 1 && 'pr-2']}>
              <dt class="text-[11.5px] uppercase tracking-[0.05em] text-(--muted)">{rate.name}</dt>
              <dd class:list={['font-display text-lg font-bold tabular-nums', rate.accent && 'text-(--accent-text)']}>{formatVnd(rate.price)}</dd>
            </div>
          ))
        }
      </dl>
      <a href={link('/price')} class="group flex h-[52px] items-center justify-center gap-2 rounded-full border border-accent text-[15px] font-semibold text-(--accent-text) transition hover:bg-accent/10 active:scale-[0.97]">
        {t('hero.cta_price')}
        <svg class="size-4 transition group-hover:translate-x-1" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M5 12h14M13 6l6 6-6 6" />
        </svg>
      </a>
    </div>
  </section>

  <script>
    const initFleetCompare = () => {
      const tabs = Array.from(document.querySelectorAll<HTMLButtonElement>('[data-metric-tab]'));
      const cards = Array.from(document.querySelectorAll<HTMLElement>('[data-fleet-card]'));
      if (!tabs.length) return;

      const select = (tab: HTMLButtonElement) => {
        const { metricTab = '', label = '', best = '', unit = '' } = tab.dataset;
        const max = Number(tab.dataset.max);
        tabs.forEach((other) => other.setAttribute('aria-pressed', String(other === tab)));
        cards.forEach((card) => {
          const value = Number(card.dataset[metricTab]);
          const isBest = value === max;
          const labelEl = card.querySelector('[data-metric-label]');
          const valueEl = card.querySelector('[data-metric-value]');
          const fillEl = card.querySelector<HTMLElement>('[data-metric-fill]');
          const bestEl = card.querySelector<HTMLElement>('[data-metric-best]');
          if (labelEl) labelEl.textContent = label;
          if (valueEl) valueEl.textContent = `${value} ${unit}`;
          if (fillEl) {
            fillEl.style.width = `${Math.round((value / max) * 100)}%`;
            fillEl.dataset.best = String(isBest);
          }
          if (bestEl) {
            bestEl.textContent = best;
            bestEl.hidden = !isBest;
          }
        });
      };

      tabs.forEach((tab) => {
        if (tab.dataset.bound) return;
        tab.dataset.bound = '1';
        tab.addEventListener('click', () => select(tab));
      });
    };
    document.addEventListener('astro:page-load', initFleetCompare);
  </script>
</Base>
