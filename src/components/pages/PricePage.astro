---
import Base from '../../layouts/Base.astro';
import PriceCalculator from '../PriceCalculator.astro';
import { useTranslations } from '../../i18n';
import type { Locale } from '../../i18n/config';
import { buildProductsJsonLd } from '../../lib/seo';
import { DAILY_RATE, OVER_3_DAYS_RATE, WEEKLY_RATE, formatVnd } from '../../data/pricing';
import { BUSINESS } from '../../data/business';

interface Props {
  locale: Locale;
  path: string;
}
const { locale, path } = Astro.props;
const t = await useTranslations(locale);

const plans = t('price.plans', { returnObjects: true }) as { name: string; note: string }[];
const tiers = [
  { ...plans[0], price: DAILY_RATE, days: 1, best: false },
  { ...plans[1], price: OVER_3_DAYS_RATE, days: 3, best: false },
  { ...plans[2], price: WEEKLY_RATE, days: 7, best: true },
  { ...plans[3], price: null, days: 30, best: false },
];
const perks = t('price.perks', { returnObjects: true }) as { title: string; body: string }[];
const faq = t('price.faq', { returnObjects: true }) as { q: string; a: string }[];

const faqJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faq.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a },
  })),
};

const kicker = 'font-display text-sm font-medium uppercase tracking-[0.2em] text-(--accent-text)';
---

<Base
  title={`${t('price.heading')} — ${t('site.name')}`}
  description={t('price.intro')}
  locale={locale}
  path={path}
  jsonLd={[...buildProductsJsonLd(), faqJsonLd]}
>
  <section class="mx-auto max-w-6xl px-5 pt-28 md:pt-36">
    <p class:list={[kicker, 'enter']}>{t('price.kicker')}</p>
    <h1 class="enter mt-3 font-display text-[clamp(2.75rem,6.4vw,5.25rem)] font-bold leading-none tracking-[-0.03em]" style="--d:.08s">{t('price.heading')}</h1>
    <p class="enter mt-4 max-w-[560px] text-base text-(--muted) md:text-lg" style="--d:.18s">{t('price.intro')}</p>

    <div class="mt-7 grid gap-4 lg:mt-14 lg:grid-cols-2 lg:items-start lg:gap-6">
      <div class="enter lg:sticky lg:top-24" style="--d:.28s">
        <PriceCalculator locale={locale} />
      </div>

      <div class="enter" style="--d:.38s">
        <div class="flex flex-col gap-2.5">
          {
            tiers.map((tier, i) => (
              <button
                type="button"
                data-tier-days={tier.days}
                aria-pressed={i === 1 ? 'true' : 'false'}
                class="flex min-h-[76px] cursor-pointer items-center justify-between gap-3 rounded-card border border-(--line) bg-(--card) px-[18px] py-3.5 text-left transition duration-300 hover:translate-x-1 hover:border-accent aria-pressed:border-accent aria-pressed:bg-(--card-2) lg:min-h-[92px] lg:px-6 lg:py-5"
              >
                <span class="flex flex-col gap-[3px]">
                  <span class="flex items-center gap-2">
                    <span class="font-display text-[13px] font-semibold uppercase tracking-[0.12em] text-(--accent-text)">{tier.name}</span>
                    {tier.best && (
                      <span class="rounded-full bg-charge px-2 py-0.5 text-[11px] font-semibold text-(--color-accent-ink)">{t('price.best_value')}</span>
                    )}
                  </span>
                  <span class="text-sm text-(--muted)">{tier.note}</span>
                </span>
                <span class="flex items-baseline gap-[5px] whitespace-nowrap">
                  <span class="font-display text-[22px] font-bold tabular-nums lg:text-3xl">
                    {tier.price === null ? t('price.contact_us') : formatVnd(tier.price)}
                  </span>
                  {tier.price !== null && <span class="text-[13px] text-(--muted)">{t('price.per_day')}</span>}
                </span>
              </button>
            ))
          }
        </div>
        <p class="mt-4 text-sm text-(--muted)">{t('price.daily.note')}</p>
      </div>
    </div>
  </section>

  <section class="mx-auto max-w-6xl px-5 pt-14 md:pt-28">
    <h2 data-reveal class="font-display text-2xl font-bold tracking-tight md:text-4xl">{t('price.includes_heading')}</h2>
    <ul data-reveal class="mt-3 grid lg:mt-8 lg:grid-cols-4 lg:gap-5">
      {
        perks.map((perk) => (
          <li data-reveal-item class="flex gap-3.5 border-b border-(--line) py-4 transition duration-300 lg:flex-col lg:rounded-card lg:border lg:bg-(--card) lg:p-6 lg:hover:-translate-y-1.5 lg:hover:border-accent">
            <span class="mt-0.5 grid size-7 shrink-0 place-items-center rounded-full bg-accent text-(--color-accent-ink)" aria-hidden="true">
              <svg class="size-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round">
                <path d="M5 12.5l4.5 4.5L19 7.5" />
              </svg>
            </span>
            <div>
              <h3 class="font-display text-[17px] font-bold leading-snug">{perk.title}</h3>
              <p class="mt-0.5 text-[14.5px] text-(--muted)">{perk.body}</p>
            </div>
          </li>
        ))
      }
    </ul>
  </section>

  <section class="mx-auto grid max-w-6xl gap-14 px-5 pt-14 md:pt-28 lg:grid-cols-[minmax(0,1.3fr)_minmax(0,0.7fr)] lg:items-start lg:gap-16">
    <div data-reveal class="flex flex-col gap-4 rounded-card border border-(--line) bg-(--card) p-6 lg:order-2">
      <div class="flex gap-3.5">
        <span class="grid size-11 shrink-0 place-items-center rounded-[14px] bg-(--card-2) text-(--accent-text)" aria-hidden="true">
          <svg class="size-[22px]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round">
            <rect x="3" y="6" width="18" height="13" rx="2.5" /><circle cx="12" cy="12.5" r="2.5" /><path d="M6.5 9.5v.01M17.5 15.5v.01" />
          </svg>
        </span>
        <div>
          <h2 class="font-display text-[22px] font-bold leading-tight">{t('price.payment_heading')}</h2>
          <p class="mt-1 text-[15px] text-(--muted)">{t('price.payment_body')}</p>
        </div>
      </div>
      <a href={`tel:${BUSINESS.phone}`} class="flex h-[52px] items-center justify-center rounded-full border border-(--line) text-[15px] font-semibold transition hover:border-accent hover:text-(--accent-text) active:scale-[0.97]">
        {t('business.call')} · {BUSINESS.phoneDisplay}
      </a>
    </div>

    <div>
      <h2 data-reveal class="font-display text-[28px] font-bold tracking-tight md:text-4xl">{t('price.faq_heading')}</h2>
      <div data-reveal class="mt-4 divide-y divide-(--line) border-y border-(--line)">
        {
          faq.map((f) => (
            <details class="group" data-faq>
              <summary class="flex min-h-16 cursor-pointer list-none items-center justify-between gap-4 py-3 font-display text-[17px] font-semibold transition hover:text-(--accent-text)">
                {f.q}
                <svg class="size-5 shrink-0 text-(--accent-text) transition-transform duration-300 group-open:rotate-45" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
                  <path d="M12 5v14M5 12h14" />
                </svg>
              </summary>
              <div data-faq-body class="overflow-hidden">
                <p class="pb-[18px] pr-9 text-[15px] text-(--muted)">{f.a}</p>
              </div>
            </details>
          ))
        }
      </div>
      <p class="mt-6 text-[13px] text-(--muted)">{t('price.disclaimer')}</p>
    </div>
  </section>
</Base>
