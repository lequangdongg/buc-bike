---
import { Image } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import { useTranslations } from '../../i18n';
import { localizePath, type Locale } from '../../i18n/config';
import { BIKES, type Bike } from '../../data/fleet';
import { DAILY_RATE, OVER_3_DAYS_RATE, WEEKLY_RATE, formatVnd } from '../../data/pricing';
import { BUSINESS } from '../../data/business';

interface Props {
  locale: Locale;
  path: string;
  bike: Bike;
}
const { locale, path, bike } = Astro.props;
const t = await useTranslations(locale);
const link = (p: string) => localizePath(p, locale);

const specs = [
  { label: t('fleet.range_label'), value: `${bike.rangeKm} km`, accent: true },
  { label: t('fleet.speed_label'), value: `${bike.topSpeedKmh} km/h`, accent: false },
  { label: t('fleet.trunk_label'), value: `${bike.trunkL} L`, accent: false },
];
const batteryNote =
  bike.trunkWithExtraBatteryL === null
    ? t('fleet.single_charge')
    : t('fleet.battery_note', { litres: bike.trunkWithExtraBatteryL });

const plans = t('price.plans', { returnObjects: true }) as { name: string; note: string }[];
const rates = [
  { name: plans[0].name, price: DAILY_RATE },
  { name: plans[1].name, price: OVER_3_DAYS_RATE },
  { name: plans[2].name, price: WEEKLY_RATE },
];
const highlights =
  bike.id === 'feliz-lite' ? (t('showcase.points', { returnObjects: true }) as { title: string; body: string }[]) : [];
const others = BIKES.filter((b) => b.id !== bike.id);

const kicker = 'font-display text-sm font-medium uppercase tracking-[0.2em] text-(--accent-text)';
---

<Base
  title={`${bike.name} — ${t('site.name')}`}
  description={`${bike.name}: ${bike.rangeKm} km ${t('fleet.range_label').toLowerCase()}, ${bike.topSpeedKmh} km/h.`}
  locale={locale}
  path={path}
>
  <section class="mx-auto max-w-6xl px-5 pt-24 md:pt-28">
    <a href={link('/fleet')} class="group inline-flex min-h-11 items-center gap-2 text-sm text-(--muted) transition hover:text-(--accent-text)">
      <svg class="size-4 transition group-hover:-translate-x-1" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M19 12H5M11 6l-6 6 6 6" />
      </svg>
      {t('fleet.back')}
    </a>

    <div class="mt-2 grid gap-6 lg:mt-4 lg:grid-cols-[minmax(0,1.05fr)_minmax(0,0.95fr)] lg:items-start lg:gap-14">
      <div class="bike-tile enter-zoom h-[340px] rounded-card border border-(--line) lg:sticky lg:top-24 lg:h-[620px]">
        <span class="dot-field absolute inset-0 opacity-70" style="-webkit-mask-image:radial-gradient(circle at 50% 50%,#000 0%,transparent 72%);mask-image:radial-gradient(circle at 50% 50%,#000 0%,transparent 72%)" aria-hidden="true"></span>
        <span class="bike-tile-glow" style={`background:${bike.glow}`} aria-hidden="true"></span>
        <svg class="absolute left-1/2 top-1/2 aspect-square h-[86%] -translate-x-1/2 -translate-y-1/2 overflow-visible" viewBox="0 0 400 400" fill="none" aria-hidden="true">
          <g style="transform-origin:200px 200px;animation:bk-spin 70s linear infinite reverse">
            <circle cx="200" cy="200" r="197" stroke="var(--line)" stroke-width="1" stroke-dasharray="2 12"></circle>
          </g>
          <circle cx="200" cy="200" r="180" stroke="var(--line)" stroke-width="1"></circle>
          <circle
            cx="200"
            cy="200"
            r="180"
            stroke="var(--color-charge)"
            stroke-width="3"
            stroke-linecap="round"
            stroke-dasharray="1131"
            stroke-dashoffset="280"
            transform="rotate(-90 200 200)"
            style="animation:bk-arc 1.8s cubic-bezier(.16,1,.3,1) .3s both"
          ></circle>
        </svg>
        <Image
          src={bike.image}
          alt={bike.name}
          width={900}
          loading="eager"
          class:list={['bike-float relative w-auto max-w-[96%] object-contain drop-shadow-[0_24px_34px_rgba(0,0,0,0.55)]', bike.imagePadded ? 'h-[98%]' : 'h-[76%]']}
          style={`view-transition-name: bike-${bike.id}`}
        />
      </div>

      <div>
        <span class="enter inline-flex items-center gap-1.5 rounded-full border border-(--line) bg-(--card) px-3 py-1 text-xs font-medium text-(--accent-text)" style="--d:.1s">
          <span class="size-1.5 rounded-full bg-charge" aria-hidden="true"></span>
          {t('fleet.available')}
        </span>
        <h1 class="enter mt-3.5 font-display text-[clamp(2.5rem,5vw,4.25rem)] font-bold leading-none tracking-[-0.03em]" style="--d:.16s">{bike.name}</h1>

        <dl class="mt-6 grid grid-cols-3 gap-2.5">
          {
            specs.map((spec, i) => (
              <div
                class:list={['enter flex flex-col gap-1 rounded-2xl border bg-(--card) px-3 py-3.5 lg:px-4 lg:py-[18px]', spec.accent ? 'border-accent' : 'border-(--line)']}
                style={`--d:${0.26 + i * 0.08}s`}
              >
                <dt class="text-[11px] uppercase tracking-[0.06em] text-(--muted)">{spec.label}</dt>
                <dd class:list={['font-display text-[22px] font-bold leading-tight lg:text-[28px]', spec.accent && 'text-(--accent-text)']}>{spec.value}</dd>
              </div>
            ))
          }
        </dl>
        <p class="enter mt-3.5 text-sm text-(--muted)" style="--d:.48s">{batteryNote}</p>

        <div class="enter mt-5 flex flex-col gap-[18px] rounded-card border border-(--line) bg-(--card) p-5" style="--d:.56s">
          <p class="flex items-baseline gap-2 text-[15px] text-(--muted)">
            <span>{t('fleet.from')}</span>
            <span class="font-display text-[clamp(2.25rem,3.6vw,3rem)] font-bold leading-none tabular-nums text-(--accent-text)">{formatVnd(WEEKLY_RATE)}</span>
            <span>{t('price.per_day')}</span>
          </p>
          <dl class="grid grid-cols-3 border-t border-(--line)">
            {
              rates.map((rate, i) => (
                <div class:list={['flex flex-col gap-0.5 pt-3.5', i > 0 && 'border-l border-(--line) pl-3', i < rates.length - 1 && 'pr-2']}>
                  <dt class="text-[11.5px] uppercase tracking-[0.05em] text-(--muted)">{rate.name}</dt>
                  <dd class="font-display text-[17px] font-bold tabular-nums">{formatVnd(rate.price)}</dd>
                </div>
              ))
            }
          </dl>
          <div class="flex gap-2.5">
            <a
              href={BUSINESS.whatsapp}
              target="_blank"
              rel="noopener"
              class="group flex h-14 flex-1 items-center justify-center gap-2 rounded-full bg-accent font-semibold text-(--color-accent-ink) shadow-lg shadow-accent/25 transition hover:brightness-110 active:scale-[0.97]"
            >
              {t('fleet.book_this')}
              <svg class="size-[18px] transition group-hover:translate-x-1" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M5 12h14M13 6l6 6-6 6" />
              </svg>
            </a>
            <a href={link('/price')} class="flex h-14 items-center justify-center rounded-full border border-(--line) px-[22px] text-[15px] font-semibold transition hover:border-accent hover:text-(--accent-text) active:scale-[0.97]">
              {t('nav.price')}
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>

  {
    highlights.length > 0 && (
      <section class="mx-auto max-w-6xl px-5 pt-14 md:pt-28">
        <div data-reveal>
          <p class={kicker}>{t('showcase.kicker')}</p>
          <h2 class="mt-3 font-display text-[28px] font-bold tracking-tight md:text-[44px] md:leading-tight">{t('showcase.heading')}</h2>
        </div>
        <ol data-reveal class="mt-5 grid border-t border-(--line) lg:mt-8 lg:grid-cols-2 lg:gap-x-14">
          {highlights.map((point, i) => (
            <li data-reveal-item class="flex gap-4 border-b border-(--line) py-[18px]">
              <span class="w-10 shrink-0 font-display text-[28px] font-bold leading-tight tabular-nums text-(--accent-text)">{String(i + 1).padStart(2, '0')}</span>
              <div>
                <h3 class="font-display text-lg font-bold leading-snug">{point.title}</h3>
                <p class="mt-1 text-[14.5px] text-(--muted)">{point.body}</p>
              </div>
            </li>
          ))}
        </ol>
      </section>
    )
  }

  <section class="mx-auto max-w-6xl px-5 pt-14 md:pt-28">
    <h2 data-reveal class="font-display text-[28px] font-bold tracking-tight md:text-[44px] md:leading-tight">{t('fleet.heading')}</h2>
    <div data-reveal class="mt-[18px] grid gap-3 lg:grid-cols-2 lg:gap-5">
      {
        others.map((other) => (
          <a
            href={link(`/fleet/${other.id}`)}
            data-reveal-item
            class="group flex items-center gap-3.5 rounded-card border border-(--line) bg-(--card) p-3 transition duration-300 hover:-translate-y-1 hover:border-accent"
          >
            <span class="bike-tile h-[84px] w-24 shrink-0 rounded-xl">
              <Image src={other.image} alt="" width={200} class:list={['w-auto object-contain transition duration-500 group-hover:scale-110', other.imagePadded ? 'h-[112%] max-w-none' : 'h-[86%]']} />
            </span>
            <span class="flex flex-1 flex-col gap-0.5">
              <span class="font-display text-[17px] font-bold leading-tight">{other.name}</span>
              <span class="text-sm text-(--muted)">{other.rangeKm} km · {other.topSpeedKmh} km/h</span>
            </span>
            <svg class="mr-1.5 size-[18px] shrink-0 text-(--muted) transition group-hover:translate-x-1 group-hover:text-(--accent-text)" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M5 12h14M13 6l6 6-6 6" />
            </svg>
          </a>
        ))
      }
    </div>
  </section>
</Base>
